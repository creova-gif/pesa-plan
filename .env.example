# Maokoto environment variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git — it is listed in .gitignore.

# Get from your Supabase project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only. Read by the AI gateway, never by the browser bundle.
# Leave unset to keep the on-device budget coach.
# Also set SUPABASE_URL and SUPABASE_ANON_KEY (without a client prefix) before cloud AI can run.
ANTHROPIC_API_KEY=
